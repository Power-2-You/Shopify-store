{%- comment -%}
  ============================================================================
  THE HOUSE OF MOUTH — B2B MINI NAV
  A compact circular-icon navigation strip for the B2B page.
  Install: Online Store > Themes > Edit code > Sections > Add a new section,
  name it "thom-b2b-mini-nav", paste this file, save. Then add the section to a
  page/template via the theme editor and it loads pre-populated.

  Links: each circle's link is set in the theme editor. The preset ships with
  best-guess collection handles (e.g. /collections/teeth-whitening). Point each
  one at the matching collection on your store. "Shop All" -> /collections/all,
  "Shop by Brand" -> wherever your brand index lives.
  ============================================================================
{%- endcomment -%}

{%- if section.settings.load_work_sans -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&display=swap">
{%- endif -%}

<div
  class="thom-mininav"
  style="
    --tn-icon: {{ section.settings.color_icon }};
    --tn-label: {{ section.settings.color_label }};
    --tn-caption: {{ section.settings.color_caption }};
    --tn-circle-bg: {{ section.settings.color_circle_bg }};
    --tn-circle-border: {{ section.settings.color_circle_border }};
    --tn-hover-bg: {{ section.settings.color_hover_bg }};
    --tn-hover-icon: {{ section.settings.color_hover_icon }};
    --tn-hover-border: {{ section.settings.color_hover_border }};
    --tn-focus: {{ section.settings.color_focus_ring }};
    --tn-size: {{ section.settings.circle_size }}px;
    --tn-size-mobile: {{ section.settings.circle_size_mobile }}px;
    --tn-align: {{ section.settings.align }};
    --tn-pt: {{ section.settings.padding_top }}px;
    --tn-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="thom-mininav__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="thom-mininav__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.caption != blank -%}
      <p class="thom-mininav__caption">{{ section.settings.caption | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      {%- assign nav_label = section.settings.heading | default: 'Browse the range' -%}
      <nav class="thom-mininav__nav" aria-label="{{ nav_label | escape }}">
      <ul class="thom-mininav__list" role="list">
        {%- for block in section.blocks -%}
          <li class="thom-mininav__item" {{ block.shopify_attributes }}>
            <a class="thom-mininav__link" href="{{ block.settings.link | default: '#' }}">
              <span class="thom-mininav__circle">
                {%- if block.settings.image != blank -%}
                  <img
                    class="thom-mininav__img"
                    src="{{ block.settings.image | image_url: width: 220 }}"
                    alt=""
                    loading="lazy"
                    width="110"
                    height="110"
                  >
                {%- else -%}
          {%- case block.settings.icon -%}
          {%- when 'grid' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.6"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.6"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.6"/></svg>
          {%- when 'tag' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11.6 3H5a2 2 0 0 0-2 2v6.6a2 2 0 0 0 .59 1.42l7.4 7.4a2 2 0 0 0 2.82 0l5.6-5.6a2 2 0 0 0 0-2.82l-7.4-7.4A2 2 0 0 0 11.6 3Z"/><circle cx="8" cy="8" r="1.4"/></svg>
          {%- when 'sparkles' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3.5l1.7 4.3 4.3 1.7-4.3 1.7L12 15.5l-1.7-4.3L6 9.5l4.3-1.7L12 3.5Z"/><path d="M18.6 14.4l.6 1.6 1.6.6-1.6.6-.6 1.6-.6-1.6-1.6-.6 1.6-.6.6-1.6Z"/><path d="M5.6 14.6l.5 1.4 1.4.5-1.4.5-.5 1.4-.5-1.4-1.4-.5 1.4-.5.5-1.4Z"/></svg>
          {%- when 'tooth' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7.5 4C5.6 4 4 5.4 4 7.6c0 1.7.5 2.9 1 4.6.3 1 .4 2 .6 3.2.2 1.3.4 2.7.9 3.6.3.6 1 .8 1.5.4.5-.4.6-1.2.8-2.2.2-1.1.4-2.3 1.2-2.3s1 1.2 1.2 2.3c.2 1 .3 1.8.8 2.2.5.4 1.2.2 1.5-.4.5-.9.7-2.3.9-3.6.2-1.2.3-2.2.6-3.2.5-1.7 1-2.9 1-4.6C20 5.4 18.4 4 16.5 4c-1.6 0-2.5 1-4.5 1S9.1 4 7.5 4Z"/></svg>
          {%- when 'brush' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="16.6" y="10.3" width="4.6" height="3.4" rx="1.7"/><line x1="16.6" y1="12" x2="4" y2="12"/><path d="M14 12 12.1 8.9"/><path d="M14 12 12.1 15.1"/><path d="M11.5 12 9.8 9.3"/><path d="M11.5 12 9.8 14.7"/><path d="M9 12 7.5 9.7"/><path d="M9 12 7.5 14.3"/><path d="M6.6 12 5.4 10.2"/><path d="M6.6 12 5.4 13.8"/></svg>
          {%- when 'toothbrush' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.8" y="13.5" width="7.2" height="3.8" rx="1.5"/><line x1="4.4" y1="13.5" x2="4.4" y2="10.8"/><line x1="6" y1="13.5" x2="6" y2="10.8"/><line x1="7.6" y1="13.5" x2="7.6" y2="10.8"/><line x1="9.2" y1="13.5" x2="9.2" y2="10.8"/><path d="M10 15.4H20.6"/><path d="M20.6 14.1v2.6"/></svg>
          {%- when 'zap' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13 3 5 13.5h6l-2 7.5 8-10.5h-6l2-7Z"/></svg>
          {%- when 'droplet' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3.2s6 6 6 9.8a6 6 0 0 1-12 0c0-3.8 6-9.8 6-9.8Z"/></svg>
          {%- when 'wind' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 8h10a2.5 2.5 0 1 0-2.5-2.5"/><path d="M3 16h13a2.5 2.5 0 1 1-2.5 2.5"/><path d="M3 12h7.5a2 2 0 1 0-2-2"/></svg>
          {%- when 'bottle' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10.5 7V5.6a1.5 1.5 0 0 1 3 0V7"/><rect x="9" y="7" width="6" height="2.2" rx="1.1"/><path d="M9.4 9.2h5.2V17a2.6 2.6 0 0 1-5.2 0V9.2Z"/><line x1="11" y1="12" x2="13" y2="12"/><line x1="11" y1="14.5" x2="13" y2="14.5"/></svg>
          {%- when 'package' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3 4 7v10l8 4 8-4V7l-8-4Z"/><path d="m4 7 8 4 8-4"/><path d="M12 21V11"/><path d="m8 5 8 4"/></svg>
          {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3 5 6v5c0 4.2 2.9 7.7 7 9 4.1-1.3 7-4.8 7-9V6l-7-3Z"/><path d="m9.2 12 1.9 1.9 3.7-3.8"/></svg>
          {%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 19c.6-7.6 6.4-13.4 14-14 .6 7.6-6.4 14-14 14Z"/><path d="M5 19c2.2-4.8 5.4-7.4 9.5-8.5"/></svg>
          {%- when 'heart' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20S4 14.6 4 9.4A4.2 4.2 0 0 1 12 7a4.2 4.2 0 0 1 8 2.4C20 14.6 12 20 12 20Z"/></svg>
          {%- when 'sun' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><line x1="12" y1="3" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="21"/><line x1="3" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="21" y2="12"/><line x1="5.6" y1="5.6" x2="7" y2="7"/><line x1="17" y1="17" x2="18.4" y2="18.4"/><line x1="5.6" y1="18.4" x2="7" y2="17"/><line x1="17" y1="7" x2="18.4" y2="5.6"/></svg>
