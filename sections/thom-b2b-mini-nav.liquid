</div>

{% stylesheet %}
.thom-mininav{
  font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  padding-top: var(--tn-pt, 36px);
  padding-bottom: var(--tn-pb, 40px);
}
.thom-mininav__inner{ max-width: 1180px; margin: 0 auto; padding: 0 20px; }
.thom-mininav__heading{
  margin: 0; text-align: center; color: var(--tn-label, #37456E);
  font-size: 13px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
}
.thom-mininav__caption{
  margin: 6px 0 0; text-align: center; color: var(--tn-caption, #6B7793);
  font-size: 14px; font-weight: 400; line-height: 1.5;
}
.thom-mininav__list{
  list-style: none; margin: 22px 0 0; padding: 6px;
  display: flex; flex-wrap: wrap; justify-content: var(--tn-align, center);
  gap: 22px 16px;
}
.thom-mininav__item{ margin: 0; }
.thom-mininav__link{
  display: flex; flex-direction: column; align-items: center; gap: 11px;
  width: calc(var(--tn-size, 78px) + 18px);
  text-decoration: none; color: inherit; -webkit-tap-highlight-color: transparent;
}
.thom-mininav__circle{
  width: var(--tn-size, 78px); height: var(--tn-size, 78px);
  border-radius: 50%; overflow: hidden;
  display: grid; place-items: center;
  background: var(--tn-circle-bg, #F5F7FB);
  border: 1.5px solid var(--tn-circle-border, #E3E7F0);
  color: var(--tn-icon, #37456E);
  transition: transform .18s ease, background-color .18s ease, border-color .18s ease, color .18s ease, box-shadow .18s ease;
}
.thom-mininav__circle svg{ width: 42%; height: 42%; display: block; }
.thom-mininav__img{ width: 100%; height: 100%; object-fit: cover; display: block; }
.thom-mininav__label{
  text-align: center; color: var(--tn-label, #37456E); line-height: 1.25;
  font-size: 11.5px; font-weight: 600; letter-spacing: .07em; text-transform: uppercase;
}
.thom-mininav__link:hover .thom-mininav__circle,
.thom-mininav__link:focus-visible .thom-mininav__circle{
  background: var(--tn-hover-bg, #37456E);
  border-color: var(--tn-hover-border, #37456E);
  color: var(--tn-hover-icon, #FFFFFF);
  transform: translateY(-3px);
  box-shadow: 0 10px 20px -10px rgba(55, 69, 110, .5);
}
.thom-mininav__link:focus-visible{ outline: none; }
.thom-mininav__link:focus-visible .thom-mininav__circle{
  box-shadow: 0 0 0 3px var(--tn-focus, #9CCB3B);
}
@media (prefers-reduced-motion: reduce){
  .thom-mininav__circle{ transition: none; }
  .thom-mininav__link:hover .thom-mininav__circle,
  .thom-mininav__link:focus-visible .thom-mininav__circle{ transform: none; }
}
@media (max-width: 749px){
  .thom-mininav__list{
    flex-wrap: nowrap; justify-content: flex-start;
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    gap: 12px; padding: 6px 20px 10px; margin: 18px -20px 0;
    scrollbar-width: none;
  }
  .thom-mininav__list::-webkit-scrollbar{ display: none; }
  .thom-mininav__item{ scroll-snap-align: start; }
  .thom-mininav__link{ width: calc(var(--tn-size-mobile, 64px) + 6px); gap: 9px; }
  .thom-mininav__circle{ width: var(--tn-size-mobile, 64px); height: var(--tn-size-mobile, 64px); }
  .thom-mininav__label{ font-size: 10.5px; }
}
{% endstylesheet %}

