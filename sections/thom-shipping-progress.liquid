{%- comment -%} THE HOUSE OF MOUTH — Free Freight Progress. Self-contained free-shipping threshold nudge. Reads cart.total_price at render. No external assets. {%- endcomment -%}
{%- liquid
  assign threshold_dollars = section.settings.threshold_amount | default: 0
  assign threshold_cents = threshold_dollars | times: 100
  assign cart_total = cart.total_price | default: 0
  assign remaining = threshold_cents | minus: cart_total
  assign progress_pct = 0
  if threshold_cents > 0
    assign progress_pct = cart_total | times: 100 | divided_by: threshold_cents
    if progress_pct < 0
      assign progress_pct = 0
    endif
    if progress_pct > 100
      assign progress_pct = 100
    endif
  endif
-%}
{%- if threshold_cents > 0 -%}
  {%- assign surface_class = '' -%}
  {%- if section.settings.use_surface -%}{%- assign surface_class = ' thom-sp--surface' -%}{%- endif -%}
  <div class="thom-sp{{ surface_class }}" style="--thom-sp-pt:{{ section.settings.padding_top }}px;--thom-sp-pb:{{ section.settings.padding_bottom }}px;--thom-sp-bar:{{ section.settings.bar_color }};--thom-sp-track:{{ section.settings.track_color }};--thom-sp-text:{{ section.settings.text_color }};">
    <div class="thom-sp__in">
      <p class="thom-sp__msg">
        {%- if section.settings.show_icon -%}
          <svg class="thom-sp__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 6h11v9H3z"/><path d="M14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
        {%- endif -%}
        <span class="thom-sp__txt">
          {%- if remaining > 0 -%}
            {{- section.settings.message_prefix | escape -}}
            <span class="thom-sp__amt">{{ remaining | money }}</span>
            {{- section.settings.message_suffix | escape -}}
          {%- else -%}
            <span class="thom-sp__done">{{ section.settings.success_message | escape }}</span>
          {%- endif -%}
        </span>
      </p>
      <div class="thom-sp__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress_pct }}" aria-label="{{ 'Progress toward free freight' | escape }}">
        <span class="thom-sp__fill" style="width:{{ progress_pct }}%;"></span>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
.thom-sp{font-family:'Work Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:var(--thom-sp-text,#37456E);max-width:1200px;margin:0 auto;padding:var(--thom-sp-pt,20px) 20px var(--thom-sp-pb,20px)}
.thom-sp__in{display:block}
.thom-sp--surface .thom-sp__in{background:#F5F7FB;border:1px solid #E3E7F0;border-radius:14px;padding:18px 20px}
.thom-sp__msg{display:flex;align-items:center;gap:10px;margin:0 0 12px;font-size:14px;font-weight:600;line-height:1.4;color:var(--thom-sp-text,#37456E)}
.thom-sp__ic{width:22px;height:22px;flex:none;color:var(--thom-sp-bar,#37456E)}
.thom-sp__txt{display:inline}
.thom-sp__amt{font-weight:800;color:#2c3650;white-space:nowrap}
.thom-sp__done{font-weight:800;color:#2c3650}
.thom-sp__track{position:relative;width:100%;height:10px;border-radius:999px;background:var(--thom-sp-track,#E3E7F0);overflow:hidden}
.thom-sp__fill{position:absolute;inset:0 auto 0 0;height:100%;border-radius:999px;background:var(--thom-sp-bar,#37456E);transition:width .5s cubic-bezier(.4,0,.2,1)}
.thom-sp__fill::after{content:"";position:absolute;inset:0;border-radius:999px;background:linear-gradient(90deg,rgba(156,203,59,0),rgba(156,203,59,.35));pointer-events:none}
.thom-sp a:focus-visible,.thom-sp__track:focus-visible{outline:2px solid #9CCB3B;outline-offset:2px}
@media (max-width:749px){.thom-sp__msg{font-size:13px}.thom-sp--surface .thom-sp__in{padding:16px}}
@media (prefers-reduced-motion:reduce){.thom-sp__fill{transition:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "Free Freight Progress",
  "tag": "section",
  "class": "thom-shipping-progress-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the free-freight progress bar using the cart value at the moment the page renders. For live updates inside the cart drawer, pair this with the theme's cart JS (a future enhancement)."
    },
    { "type": "header", "content": "Threshold" },
    { "type": "range", "id": "threshold_amount", "min": 0, "max": 500, "step": 5, "unit": "$", "label": "Free freight threshold (dollars)", "info": "Set to 0 to hide the section.", "default": 99 },
    { "type": "header", "content": "Messages" },
    { "type": "text", "id": "message_prefix", "label": "Message prefix", "default": "You're " },
    { "type": "text", "id": "message_suffix", "label": "Message suffix", "default": " away from free freight" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You've unlocked free freight!" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bar_color", "label": "Bar (fill) colour", "default": "#37456E" },
    { "type": "color", "id": "track_color", "label": "Track colour", "default": "#E3E7F0" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#37456E" },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "use_surface", "label": "Show on a surface panel", "default": true },
    { "type": "checkbox", "id": "show_icon", "label": "Show truck icon", "default": true },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Top padding", "default": 20 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Bottom padding", "default": 20 }
  ],
  "presets": [
    {
      "name": "Free Freight Progress",
      "settings": {
        "threshold_amount": 99,
        "message_prefix": "You're ",
        "message_suffix": " away from free freight",
        "success_message": "You've unlocked free freight!",
        "bar_color": "#37456E",
        "track_color": "#E3E7F0",
        "text_color": "#37456E",
        "use_surface": true,
        "show_icon": true,
        "padding_top": 20,
        "padding_bottom": 20
      }
    }
  ]
}
{% endschema %}
