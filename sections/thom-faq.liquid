{%- comment -%} THE HOUSE OF MOUTH B2B FAQ. Self-contained accessible accordion (native details/summary, zero JS) with optional FAQPage JSON-LD. No external assets. {%- endcomment -%}
{%- liquid
  assign qa_blocks = section.blocks | where: 'type', 'qa'
  assign pt = section.settings.padding_top
  assign pb = section.settings.padding_bottom
-%}
<div
  class="thmfaq"
  style="--thmfaq-bg:{{ section.settings.bg_color }};--thmfaq-heading:{{ section.settings.heading_color }};--thmfaq-text:{{ section.settings.text_color }};--thmfaq-accent:{{ section.settings.accent_color }};--thmfaq-pt:{{ pt }}px;--thmfaq-pb:{{ pb }}px;"
>
  <div class="thmfaq__wrap">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="thmfaq__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="thmfaq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="thmfaq__h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="thmfaq__intro">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if qa_blocks.size > 0 -%}
      <div class="thmfaq__list thmfaq--{{ section.settings.layout }}">
        {%- for block in qa_blocks -%}
          {%- if block.settings.question != blank or block.settings.answer != blank -%}
            <details
              class="thmfaq__item"
              {%- if section.settings.open_first and forloop.first %} open{% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="thmfaq__q">
                <span class="thmfaq__qtext">{{ block.settings.question | escape }}</span>
                <span class="thmfaq__chev" aria-hidden="true" focusable="false">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
                </span>
              </summary>
              {%- if block.settings.answer != blank -%}
                <div class="thmfaq__a">{{ block.settings.answer }}</div>
              {%- endif -%}
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{%- if section.settings.emit_schema and qa_blocks.size > 0 -%}
  {%- capture thmfaq_ld -%}
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign thmfaq_first = true -%}
    {%- for block in qa_blocks -%}
      {%- if block.settings.question != blank and block.settings.answer != blank -%}
        {%- unless thmfaq_first %},{% endunless -%}
        {%- assign thmfaq_first = false -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ block.settings.answer | strip_html | json }}
      }
    }
      {%- endif -%}
    {%- endfor -%}
  ]
}
  {%- endcapture -%}
  {%- assign thmfaq_ld = thmfaq_ld | strip -%}
  {%- if thmfaq_ld contains '"@type": "Question"' -%}
    <script type="application/ld+json">{{ thmfaq_ld }}</script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
.thmfaq{font-family:'Work Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;background:var(--thmfaq-bg,#fff);color:var(--thmfaq-text,#5b6478);padding-top:var(--thmfaq-pt,56px);padding-bottom:var(--thmfaq-pb,56px)}
.thmfaq__wrap{max-width:1200px;margin:0 auto;padding:0 20px}
.thmfaq__head{max-width:720px;margin:0 0 28px}
.thmfaq__eyebrow{font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--thmfaq-accent,#9CCB3B);margin:0 0 8px}
.thmfaq__h2{font-size:28px;line-height:1.15;font-weight:800;color:var(--thmfaq-heading,#2c3650);margin:0}
.thmfaq__intro{font-size:15px;line-height:1.6;color:var(--thmfaq-text,#5b6478);margin:14px 0 0}
.thmfaq__intro p{margin:0 0 10px}
.thmfaq__intro p:last-child{margin-bottom:0}
.thmfaq__list{display:grid;gap:12px}
.thmfaq--two-column{grid-template-columns:1fr 1fr;align-items:start}
.thmfaq__item{border:1px solid #E3E7F0;border-radius:12px;background:#fff;overflow:hidden;transition:border-color .15s ease,box-shadow .15s ease}
.thmfaq__item[open]{border-color:var(--thmfaq-accent,#9CCB3B);box-shadow:0 10px 22px -14px rgba(55,69,110,.45)}
.thmfaq__q{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:16px 18px;font-size:15px;font-weight:700;color:var(--thmfaq-heading,#2c3650);line-height:1.35}
.thmfaq__q::-webkit-details-marker{display:none}
.thmfaq__q:hover{color:var(--thmfaq-accent,#9CCB3B)}
.thmfaq__q:focus-visible{outline:2px solid var(--thmfaq-heading,#37456E);outline-offset:2px;border-radius:8px}
.thmfaq__qtext{flex:1 1 auto}
.thmfaq__chev{flex:none;display:grid;place-items:center;width:26px;height:26px;color:#37456E}
.thmfaq__chev svg{width:20px;height:20px;transition:transform .2s ease}
.thmfaq__item[open] .thmfaq__chev svg{transform:rotate(180deg)}
.thmfaq__a{padding:0 18px 18px;font-size:14.5px;line-height:1.6;color:var(--thmfaq-text,#5b6478)}
.thmfaq__a p{margin:0 0 10px}
.thmfaq__a p:last-child{margin-bottom:0}
.thmfaq__a a{color:#37456E;font-weight:600;text-decoration:underline}
.thmfaq__a ul,.thmfaq__a ol{margin:0 0 10px;padding-left:20px}
.thmfaq__a li{margin:0 0 4px}
@media (max-width:749px){.thmfaq__h2{font-size:23px}.thmfaq--two-column{grid-template-columns:1fr}.thmfaq__q{font-size:14.5px;padding:14px 16px}.thmfaq__a{padding:0 16px 16px}}
@media (prefers-reduced-motion:reduce){.thmfaq__item,.thmfaq__chev svg{transition:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "B2B FAQ",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Wholesale FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions from the trade counter" },
    { "type": "richtext", "id": "intro", "label": "Intro (optional)" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "one-column", "label": "One column" },
        { "value": "two-column", "label": "Two column" }
      ],
      "default": "one-column"
    },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question by default", "default": false },
    { "type": "checkbox", "id": "emit_schema", "label": "Output FAQ rich-results schema (JSON-LD)", "default": true },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading & question text", "default": "#2c3650" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#5b6478" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#9CCB3B" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Padding bottom", "default": 56 }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Q&A",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What's your minimum order?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add your answer here.</p>" }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "B2B FAQ",
      "blocks": [
        {
          "type": "qa",
          "settings": {
            "question": "Is there a minimum order quantity or case-pack requirement?",
            "answer": "<p>Trade orders have a minimum of <strong>$150 ex GST</strong>. Most lines ship in full case packs (typically 6, 12 or 24 units), and the case-pack size is listed on each product page. If you need to trial a line, ask us about single-carton sampling.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "How much is freight, and when do I get free shipping?",
            "answer": "<p>Flat-rate freight is <strong>$14.95</strong> Australia-wide. Orders over <strong>$99 ex GST</strong> ship <strong>free</strong>. Bulky or pallet orders are quoted separately &mdash; contact your account manager for a freight quote.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "What are your dispatch and lead times?",
            "answer": "<p>In-stock orders placed before <strong>1pm AEST</strong> on a business day are dispatched same day from our Gold Coast warehouse. Metro deliveries typically arrive in 1&ndash;3 business days; regional and WA/NT allow 3&ndash;7. Back-ordered lines show an expected date at checkout.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "How do I open a trade account and see wholesale pricing?",
            "answer": "<p>Apply online through <a href=\"/account/register\">Trade account registration</a> with your practice name and ABN. Once approved (usually within one business day) your wholesale pricing shows automatically when you log in, and you can reorder in a couple of clicks.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Do you provide GST tax invoices?",
            "answer": "<p>Yes. Every order includes a compliant Australian <strong>GST tax invoice</strong> showing our ABN and the GST component, emailed on dispatch and always available in your account order history for your BAS and bookkeeping.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
